# Local serverless-offline / tests. Deployed Lambdas read SES from SSM
# /${stage}/ses/ses_from_email and the webhook secret from
# /${stage}/email/hook-secret (published by talvio-terraform-iac).

AWS_REGION=us-west-1
STAGE=dev
SES_FROM_EMAIL=no-reply@dev.talvio.co

# Standard Webhooks secret, same value Auth will use (MDI-184).
# Format: v1,whsec_<base64>
SEND_EMAIL_HOOK_SECRET=v1,whsec_dGVzdC1sb2NhbC1ob29rLXNlY3JldC0zMi1ieXRlcw
